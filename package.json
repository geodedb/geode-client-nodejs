{
  "name": "@geodedb/client",
  "version": "1.3.1",
  "description": "Node.js client library for Geode graph database (QUIC/gRPC + TLS 1.3)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "proto",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:property": "vitest run --config vitest.property.config.ts",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "bench": "vitest bench",
    "proto": "bash scripts/generate-proto.sh",
    "proto:check": "bash scripts/check-proto.sh",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "geode",
    "graph",
    "database",
    "gql",
    "quic",
    "tls",
    "client"
  ],
  "author": "CodePros",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/devnw/codepros/geode/geode-client-nodejs.git"
  },
  "homepage": "https://gitlab.com/devnw/codepros/geode",
  "bugs": {
    "url": "https://gitlab.com/devnw/codepros/geode/geode-client-nodejs/-/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@matrixai/quic": "^2.0.9",
    "decimal.js-light": "^2.5.1",
    "protobufjs": "^8.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.0",
    "ts-proto": "^2.13.0",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
